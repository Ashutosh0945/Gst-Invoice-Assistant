DATABASE_URL=postgresql+psycopg2://gst:gst@localhost:5432/gst
# Supabase (production): use the pooled "Transaction" connection string from
# Project Settings -> Database -> Connection string -> Transaction pooler
# (port 6543, not 5432 -- 5432 is the direct connection and will run out of
# connections fast under serverless). Looks like:
#   postgresql+psycopg2://postgres.xxxxxxxx:[email protected]:6543/postgres
DATA_DIR=data
OPENROUTER_API_KEY=your_openrouter_api_key_here                    # optional: if set, API requires header X-API-Key

# Your own company GSTIN (buyer). Used for place-of-supply / tax-type checks.
OUR_GSTIN=

# OCR / extraction
OCR_LANG=en
OCR_USE_GPU=false
RENDER_DPI=200
LAYOUTLM_MODEL_PATH=           # empty => rule-based extractor (baseline) is used

# Decision thresholds (calibrate on your validation set)
AUTO_APPROVE_THRESHOLD=0.90

# LLM explanation layer (optional; system works without it)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_ENABLED=true

# --- e-invoice QR verification ---
# Public key(s) of the e-invoice portal, used to check the QR signature (comma-separated).
# The demo seed script creates a DEMO key; for real invoices use the key published by NIC.
EINVOICE_PUBLIC_KEY_PATHS=data/samples/demo_einvoice_keys/public.pem

# --- ITC rules ---
# HSN/SAC prefixes that are your own line of business. Section 17(5) lets you claim
# otherwise-blocked credit (cabs, coaches, catering...) when you supply the same service onward.
# Example for a travel/tour business: 9964,9966,9985
ITC_SAME_LINE_PREFIXES=
# PO_REQUIRED=true makes a missing purchase order a warning instead of a note.
PO_REQUIRED=false

# --- Web app ---
BACKEND_URL=http://localhost:8000   # where Next.js finds the API when not on Vercel
